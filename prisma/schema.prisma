// Schema Prisma do FlowDesk API.
// Mapeamento direto das tabelas em db/schema.sql do FlowDesk front.

generator client {
  provider      = "prisma-client-js"
  // native = host (dev local). linux-musl-openssl-3.0.x = Docker alpine (prod).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  master
  user
}

enum UserStatus {
  active
  blocked
}

enum SupportLevel {
  N1
  N2
  N3
}

enum DemandChannel {
  slack
  sql
}

model User {
  id                       String       @id @default(uuid()) @db.Uuid
  login                    String       @unique
  email                    String       @unique
  name                     String
  cpf                      String?      @db.VarChar(14)
  phone                    String?      @db.VarChar(32)
  role                     UserRole     @default(user)
  status                   UserStatus   @default(active)
  passwordHash             String       @map("password_hash")
  isFirstAccess            Boolean      @default(true) @map("is_first_access")
  passwordResetRequested   Boolean      @default(false) @map("password_reset_requested")
  language                 String?      @default("pt-BR") @db.VarChar(8)
  themePreferences         Json?        @map("theme_preferences")
  failedLoginCount         Int          @default(0) @map("failed_login_count")
  lockedUntil              DateTime?    @map("locked_until")
  lastLoginAt              DateTime?    @map("last_login_at")
  createdAt                DateTime     @default(now()) @map("created_at")
  createdBy                String       @map("created_by")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  groups                   UserGroup[]
  sessions                 Session[]
  auditEvents              AuditLog[]
  apiTokensCreated         ApiToken[]   @relation("ApiTokenCreatedBy")
  overridesUpdated         DemandOverride[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model Group {
  name        String      @id
  description String      @default("")
  // Mapa moduleId -> Permission[]: ex { dashboard: ["view"], demandas: ["view","edit"] }
  modules     Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  users       UserGroup[]

  @@map("groups")
}

model UserGroup {
  userId    String @map("user_id") @db.Uuid
  groupName String @map("group_name")

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group  @relation(fields: [groupName], references: [name], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, groupName])
  @@index([groupName])
  @@map("user_groups")
}

model SupportMember {
  slackLogin String       @id @map("slack_login")
  level      SupportLevel
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@map("support_members")
}

model AutoAssignRule {
  id        String   @id @default(uuid()) @db.Uuid
  rule      Json
  enabled   Boolean  @default(true)
  priority  Int      @default(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@map("auto_assign_rules")
}

model DemandOverride {
  channel    DemandChannel
  demandId   String         @map("demand_id")
  override   Json
  updatedBy  String?        @map("updated_by") @db.Uuid
  updatedAt  DateTime       @updatedAt @map("updated_at")

  updatedByUser User?       @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@id([channel, demandId])
  @@index([channel])
  @@index([updatedAt(sort: Desc)])
  @@map("demand_overrides")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ip         String?   @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  tokenHash   String    @unique @map("token_hash")
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")

  createdBy   User?     @relation("ApiTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("api_tokens")
}

model AuditLog {
  id          BigInt    @id @default(autoincrement())
  ts          DateTime  @default(now())
  actorId     String?   @map("actor_id") @db.Uuid
  actorLogin  String?   @map("actor_login")
  action      String
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  ip          String?   @db.Inet
  userAgent   String?   @map("user_agent")
  payload     Json?

  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ts(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_log")
}
