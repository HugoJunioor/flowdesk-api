# === Database ===
DATABASE_URL="postgresql://flowdesk:flowdesk@localhost:5432/flowdesk?schema=public"

# === Server ===
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# === Auth ===
# Use ao menos 32 bytes aleatorios (gerar: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
JWT_SECRET="trocar-por-segredo-aleatorio-de-32-bytes"
JWT_TTL_SECONDS=28800  # 8 horas

# === CORS ===
# Lista de origens permitidas (separadas por virgula). Em prod, apenas o front oficial.
CORS_ORIGINS="http://localhost:8080,http://localhost:5173,https://flow-desk-e2is.vercel.app"

# === Rate limit ===
RATE_LIMIT_MAX=100        # requests por janela
RATE_LIMIT_WINDOW=60000   # ms (60s)
